    {
      "id": "9c661d02-37f6-4693-bea9-10b3c770811b",
      "kind": "project",
      "data": {
        "slug": "kormarc-catalog",
        "title": "학과 자료실 장서 KORMARC 목록 정리",
        "summary": "목록이 없던 기증 도서 350건을 KORMARC로 목록화해 OPAC에서 검색되게 만들었습니다.",
        "type": "실습",
        "organization": "○○대학교 문헌정보학과 자료실",
        "startDate": "2024-09",
        "endDate": "2024-12",
        "hours": 90,
        "primarySkill": "organization",
        "skills": [
          "organization",
          "digital"
        ],
        "tools": [
          "KORMARC",
          "KDC 6판",
          "KOLAS III"
        ],
        "teamSize": 3,
        "contribution": 40,
        "role": [
          "단행본 목록 레코드 작성(245·260·300·650 필드)",
          "KDC 6판 분류기호 부여와 팀 내 교차 검토",
          "중복·오류 레코드 점검표 작성"
        ],
        "process": {
          "problem": "기증받은 전공 도서가 목록 없이 쌓여 있어 학생들이 소장 여부를 확인할 수 없었습니다.",
          "steps": [
            "자료 실사와 기증 대장 대조",
            "목록 작성 기준(필수 필드·주제명 표목) 합의",
            "1인 120건씩 레코드 작성",
            "교차 검토로 오류 수정",
            "KOLAS III에 반입하고 OPAC 검색 확인"
          ],
          "challenge": "같은 책의 판차 구분이 엇갈려 중복 레코드가 생겼습니다. ISBN과 판사항 확인 단계를 점검표에 넣어 해결했습니다."
        },
        "metrics": [
          {
            "label": "정리한 목록 레코드",
            "value": 350,
            "unit": "건",
            "key": "records_cataloged"
          },
          {
            "label": "중복·오류 레코드 수정",
            "value": 42,
            "unit": "건",
            "key": ""
          }
        ],
        "outcome": "학과 자료실 장서를 도서관 OPAC에서 검색할 수 있게 되었고, 점검표는 다음 학기 실습 자료로 쓰였습니다.",
        "learned": "목록의 일관성은 개인의 숙련보다 팀의 기준과 검토 절차에서 나온다는 것을 배웠습니다.",
        "evidence": [
          {
            "type": "image",
